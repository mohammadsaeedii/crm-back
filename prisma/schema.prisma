generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tenant mapped from an add-pnale Customer
model Tenant {
  id                 Int       @id @default(autoincrement())
  externalCustomerId String    @unique
  slug               String    @unique
  name               String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  users              User[]
  companies          Company[]
}

/// Platform users who can sign in to the panel
model User {
  id             Int       @id @default(autoincrement())
  email          String
  passwordHash   String?
  name           String?
  /// Stable subject from add-pnale (`customer_{id}`) — primary SSO mapping key
  externalUserId String?   @unique
  authProvider   String    @default("local") // local | add-pnale
  tenantId       Int?
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  companies      Company[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Company {
  id        Int             @id @default(autoincrement())
  name      String
  ownerId   Int
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenantId  Int?
  tenant    Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members   CompanyMember[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([ownerId])
  @@index([tenantId])
}

/// Users assigned to a company (selected from mock dropdown)
model CompanyMember {
  id         Int      @id @default(autoincrement())
  companyId  Int
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mockUserId String
  name       String
  email      String
  createdAt  DateTime @default(now())

  @@unique([companyId, mockUserId])
  @@index([companyId])
}

/// Short-lived OAuth PKCE/state records for the CRM OIDC client
model SsoState {
  id           String   @id
  codeVerifier String
  nonce        String
  returnTo     String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

/// One-time tickets bridging SSO callback → frontend session cookie
model AuthTicket {
  id        String    @id
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}
