DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm?schema=public
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGINS=*
PORT=3002
NODE_ENV=development
ROOT_DOMAIN=crm.dabriz.com
FRONTEND_URL=http://localhost:3003

# OIDC client (add-pnale is the IdP)
OIDC_ISSUER=http://localhost:3001
OIDC_CLIENT_ID=multi-tenant-crm
OIDC_CLIENT_SECRET=crm-dev-client-secret-change-me
OIDC_REDIRECT_URI=http://localhost:3002/auth/sso/callback

# Shared with add-pnale CRM_PROVISIONING_SECRET
PROVISIONING_SECRET=shared-provisioning-secret-change-me
